{
  "name": "@sisylabs/plugin-todo",
  "version": "0.1.0",
  "description": "Sisyphus reference plugin: rule-based todo manager. Stores tasks in plugin storage, exposes a side-region task-list view and matching card type.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Devilsparta/Sisyphus.git",
    "directory": "packages/plugin-todo"
  },
  "homepage": "https://github.com/Devilsparta/Sisyphus#readme",
  "keywords": [
    "sisyphus-plugin",
    "sisyphus",
    "todo",
    "task-manager"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/index.tsx",
    "./package.json": "./package.json"
  },
  "sisyphus": {
    "id": "plugin-todo",
    "displayName": "Todo Manager",
    "version": "0.1.0",
    "dependencies": [],
    "contributes": {
      "agents": [
        "plugin-todo.agent.todo-manager"
      ],
      "views": [
        "plugin-todo.view.task-list"
      ],
      "cards": [
        "plugin-todo.card.task-list"
      ],
      "skills": []
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:ui": "node build-ui.mjs",
    "build:daemon": "node build-daemon.mjs",
    "build": "pnpm build:daemon && pnpm build:ui",
    "dev": "node build-ui.mjs --watch",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@sisylabs/kernel": "^0.1.0",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sisylabs/kernel": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "esbuild": "^0.28.0",
    "react": "^18.3.1",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "exports": {
      ".": "./dist/index.mjs",
      "./ui": "./dist/ui.mjs",
      "./package.json": "./package.json"
    }
  }
}

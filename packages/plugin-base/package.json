{
  "name": "@sisyphus/plugin-base",
  "version": "0.1.0",
  "private": true,
  "description": "Reference plugin: react-designer agent + chat/canvas views.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/index.tsx",
    "./package.json": "./package.json"
  },
  "sisyphus": {
    "id": "plugin-base",
    "displayName": "Base Plugin",
    "version": "0.1.0",
    "dependencies": [],
    "contributes": {
      "agents": [
        "plugin-base.agent.react-designer"
      ],
      "views": [
        "plugin-base.view.chat",
        "plugin-base.view.canvas-preview"
      ],
      "cards": [],
      "skills": []
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:ui": "node build-ui.mjs",
    "build": "pnpm build:ui"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@sisyphus/kernel": "workspace:*",
    "clsx": "^2.1.1",
    "openai": "^6.33.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "react": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "esbuild": "^0.28.0",
    "react": "^18.3.1",
    "typescript": "^5"
  }
}

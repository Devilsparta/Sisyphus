{
  "name": "@sisyphus/daemon",
  "version": "0.1.0",
  "private": true,
  "description": "Sisyphus daemon — Node process hosting plugins and serving HTTP+WS API.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build:bin": "node ../../scripts/build-daemon-bin.mjs",
    "test:smoke:broker": "node --import=tsx test/broker-smoke.mts",
    "test:smoke:migration": "node --import=tsx test/plugin-migration-smoke.mts",
    "test:smoke:lifecycle": "node --import=tsx test/lifecycle-smoke.mts",
    "test:smoke:sea": "node --import=tsx test/sea-smoke.mts",
    "test:smoke": "pnpm --filter @sisyphus/plugin-hello build && pnpm test:smoke:broker && pnpm test:smoke:migration && pnpm test:smoke:lifecycle && pnpm build:bin && pnpm test:smoke:sea"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@sisyphus/kernel": "workspace:*",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0",
    "openai": "^6.33.0",
    "pacote": "^21.5.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@sisyphus/plugin-base": "workspace:*",
    "@sisyphus/plugin-hello": "workspace:*",
    "@sisyphus/plugin-todo": "workspace:*",
    "@types/node": "^20",
    "@types/pacote": "^11.1.8",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}

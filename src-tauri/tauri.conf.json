{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sisyphus",
  "version": "0.1.0",
  "identifier": "com.sisyphus.app",
  "build": {
    "frontendDist": "http://localhost:8787",
    "devUrl": "http://localhost:8787",
    "beforeBuildCommand": "pnpm --filter @sisyphus/ui build && pnpm --filter @sisyphus/daemon build:bin"
  },
  "app": {
    "windows": [
      {
        "title": "Sisyphus",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/sisyphus-daemon"],
    "resources": {
      "../packages/ui/dist": "ui"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
